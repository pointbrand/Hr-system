function distM(a,b,c,d){const r=x=>x*Math.PI/180,dLat=r(c-a),dLon=r(d-b);const q=Math.sin(dLat/2)**2+Math.cos(r(a))*Math.cos(r(c))*Math.sin(dLon/2)**2;return 2*6371000*Math.asin(Math.sqrt(q))}
// Watches GPS for up to ms and returns the most accurate fix; resolves early once accuracy <= target
function getBestPos(target,ms=15000){return new Promise((res,rej)=>{
  if(!navigator.geolocation)return rej({code:0});
  let best=null,done=false,w=null,tm=null;
  const finish=err=>{if(done)return;done=true;if(w!==null)navigator.geolocation.clearWatch(w);clearTimeout(tm);best?res(best):rej(err||{code:3})};
  w=navigator.geolocation.watchPosition(p=>{const c=p.coords;if(!best||c.accuracy<best.accuracy)best={latitude:c.latitude,longitude:c.longitude,accuracy:c.accuracy};if(c.accuracy<=target)finish()},
    err=>{if(err.code===1||!best)finish(err)},{enableHighAccuracy:true,maximumAge:0,timeout:ms});
  tm=setTimeout(()=>finish({code:3}),ms);
});}
function buildSessions(){
  const by={},out=[];
  [...S.punches].sort((a,b)=>a.ts-b.ts).forEach(p=>(by[p.empId]=by[p.empId]||[]).push(p));
  const mk=(empId,i,o)=>{const start=(i||o).ts;return {empId,inP:i,outP:o,start,date:todayStr(new Date(start)),hours:i&&o?(o.ts-i.ts)/36e5:0}};
  for(const [eid,list] of Object.entries(by)){let open=null;
    for(const p of list){if(p.type==='in'){if(open)out.push(mk(eid,open,null));open=p}else{out.push(mk(eid,open,p));open=null}}
    if(open)out.push(mk(eid,open,null));}
  return out.sort((a,b)=>b.start-a.start);
}
function lastPunch(empId){return S.punches.filter(p=>p.empId===empId).sort((a,b)=>b.ts-a.ts)[0]}
function dailyH(e){return num(e&&e.dailyHours)||num(S.settings.dailyHours)||8}
function monthStats(empId,month,all){
  const dh=dailyH(emp(empId)),days={};let missing=0;
  (all||buildSessions()).filter(s=>s.empId===empId&&s.date.startsWith(month)).forEach(s=>{if(!s.inP||!s.outP)missing++;days[s.date]=(days[s.date]||0)+s.hours});
  let worked=0,ot=0,short=0,n=0;
  for(const h of Object.values(days)){if(h<=0)continue;n++;worked+=h;ot+=Math.max(0,h-dh);short+=Math.max(0,dh-h)}
  return {days:n,worked,expected:n*dh,ot,short,missing};
}

function calcPay(e,month,all){
  const [y,m]=month.split('-').map(Number);
  const first=month+'-01', last=month+'-'+String(new Date(y,m,0).getDate()).padStart(2,'0');
  const daily=num(e.basic)/30;
  let absent=0;
  for(const [d,rec] of Object.entries(S.attendance)){ if(d>=first&&d<=last&&rec[e.id]==='absent') absent++; }
  const unpaidDays=S.leaves.filter(l=>l.empId===e.id&&l.status==='approved'&&l.type==='unpaid').reduce((a,l)=>a+leaveDaysIn(l,first,last),0);
  const gross=num(e.basic)+num(e.housing)+num(e.transport)+num(e.other);
  const absenceDed=daily*absent, unpaidDed=daily*unpaidDays;
  const gosi=e.saudi?(num(e.basic)+num(e.housing))*num(S.settings.gosiRate)/100:0;
  const adj=(S.payroll[month]||{})[e.id]||{};
  const add=num(adj.add), ded=num(adj.ded);
  const ts=monthStats(e.id,month,all),dh=dailyH(e);
  const otPay=S.settings.payOt?ts.ot*(gross/30/dh+0.5*num(e.basic)/30/dh):0;
  const shortDed=S.settings.deductShort?ts.short*num(e.basic)/30/dh:0;
  const net=gross+add-ded-absenceDed-unpaidDed-gosi+otPay-shortDed;
  return {gross,absent,absenceDed,unpaidDays,unpaidDed,gosi,add,ded,otH:ts.ot,otPay,shortH:ts.short,shortDed,net};
}

