<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>HR System</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --brand:#1E5AA8; --on-brand:#fff;
  --bg:#F2F4F7; --surface:#FFFFFF; --ink:#1A2230; --muted:#5E6A7A; --line:#DCE1E8;
  --ok:#1E7F55; --warn:#A8690F; --bad:#B83B34;
  --brand-soft:color-mix(in srgb,var(--brand) 10%,#fff);
  --brand-line:color-mix(in srgb,var(--brand) 30%,#fff);
  --r-sm:6px; --r-md:10px;
}
*{box-sizing:border-box}
html,body{margin:0;height:100%}
body{font-family:"IBM Plex Sans Arabic",system-ui,-apple-system,"Segoe UI",Tahoma,sans-serif;background:var(--bg);color:var(--ink);font-size:15px;line-height:1.5}
button,input,select,textarea{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--brand);outline-offset:2px}
.app{display:grid;grid-template-columns:248px 1fr;min-height:100vh}

/* Sidebar carries the client's brand */
.side{background:var(--brand);color:var(--on-brand);padding:24px 16px;display:flex;flex-direction:column;gap:28px;position:sticky;top:0;height:100vh}
.brandmark{display:flex;align-items:center;gap:12px;padding:0 8px}
.brandmark img{width:44px;height:44px;object-fit:contain;background:#fff;border-radius:var(--r-sm);padding:4px}
.brandmark .initial{width:44px;height:44px;border-radius:var(--r-sm);display:grid;place-items:center;font-weight:700;font-size:20px;border:1.5px solid currentColor}
.brandmark b{font-size:17px;line-height:1.25;display:block}
.brandmark small{opacity:.75;font-size:12.5px}
.nav{display:flex;flex-direction:column;gap:2px}
.nav button{all:unset;cursor:pointer;padding:10px 12px;border-radius:var(--r-sm);font-weight:500;opacity:.82}
.nav button:hover{opacity:1;background:color-mix(in srgb,currentColor 10%,transparent)}
.nav button.on{opacity:1;background:color-mix(in srgb,currentColor 16%,transparent);font-weight:600}
.nav button:focus-visible{outline:2px solid currentColor}
.side .foot{margin-top:auto;font-size:12px;opacity:.6;padding:0 8px}

.main{padding:32px 40px 64px;max-width:1240px;width:100%}
.head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap;margin-bottom:24px}
.head h1{font-size:28px;line-height:1.2;margin:0;font-weight:700;letter-spacing:-.01em}
.head p{margin:4px 0 0;color:var(--muted)}
.tools{display:flex;gap:8px;flex-wrap:wrap;align-items:center}

.btn{border:1px solid var(--line);background:var(--surface);padding:8px 14px;border-radius:var(--r-sm);cursor:pointer;font-weight:500;white-space:nowrap}
.btn:hover{border-color:var(--muted)}
.btn.primary{background:var(--brand);color:var(--on-brand);border-color:var(--brand)}
.btn.primary:hover{filter:brightness(.92)}
.btn.danger{color:var(--bad);border-color:color-mix(in srgb,var(--bad) 40%,#fff)}
.btn.sm{padding:4px 10px;font-size:13.5px}
.btn.ghost{border-color:transparent;background:transparent}

input[type=text],input[type=email],input[type=tel],input[type=number],input[type=date],input[type=month],select,textarea{
  border:1px solid var(--line);background:var(--surface);border-radius:var(--r-sm);padding:8px 10px;width:100%;min-height:38px}
textarea{min-height:70px;resize:vertical}

/* Dashboard: one figure strip, not a card grid */
.strip{display:grid;grid-template-columns:repeat(5,1fr);background:var(--surface);border:1px solid var(--line);border-radius:var(--r-md);margin-bottom:28px}
.strip div{padding:18px 20px;border-inline-start:1px solid var(--line)}
.strip div:first-child{border-inline-start:0}
.strip span{display:block;color:var(--muted);font-size:13.5px}
.strip strong{display:block;font-size:26px;font-weight:600;margin-top:4px;font-variant-numeric:tabular-nums}
.cols{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-md);overflow:hidden}
.panel h2{font-size:16px;margin:0;padding:14px 18px;border-bottom:1px solid var(--line);font-weight:600}
.panel .empty{padding:28px 18px;color:var(--muted)}
.list{list-style:none;margin:0;padding:0}
.list li{display:flex;justify-content:space-between;gap:12px;padding:12px 18px;border-top:1px solid var(--line)}
.list li:first-child{border-top:0}
.list small{color:var(--muted);display:block}

.tablewrap{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-md);overflow-x:auto}
table{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums}
th,td{padding:11px 14px;text-align:start;border-bottom:1px solid var(--line);vertical-align:middle}
th{font-weight:600;font-size:13.5px;color:var(--muted);background:#FAFBFC;white-space:nowrap}
tbody tr:last-child td{border-bottom:0}
tbody tr:hover td{background:#FAFBFD}
td small{color:var(--muted);display:block}
td.num,th.num{text-align:end}
tfoot td{font-weight:600;background:#FAFBFC;border-top:1px solid var(--line);border-bottom:0}
.rowactions{display:flex;gap:6px;justify-content:flex-end}
td input[type=number]{width:110px;min-height:32px;padding:4px 8px;text-align:end}

.tag{display:inline-block;padding:2px 9px;border-radius:999px;font-size:12.5px;font-weight:500;background:#EEF1F5;color:var(--muted)}
.tag.ok{background:color-mix(in srgb,var(--ok) 12%,#fff);color:var(--ok)}
.tag.warn{background:color-mix(in srgb,var(--warn) 14%,#fff);color:var(--warn)}
.tag.bad{background:color-mix(in srgb,var(--bad) 12%,#fff);color:var(--bad)}
.tag.brand{background:var(--brand-soft);color:var(--brand)}

.seg{display:inline-flex;border:1px solid var(--line);border-radius:var(--r-sm);overflow:hidden}
.seg button{all:unset;cursor:pointer;padding:5px 11px;font-size:13.5px;border-inline-start:1px solid var(--line)}
.seg button:first-child{border-inline-start:0}
.seg button:focus-visible{outline:2px solid var(--brand);outline-offset:-2px}
.seg button.on[data-s=present]{background:var(--ok);color:#fff}
.seg button.on[data-s=late]{background:var(--warn);color:#fff}
.seg button.on[data-s=absent]{background:var(--bad);color:#fff}

.emptystate{background:var(--surface);border:1px dashed var(--line);border-radius:var(--r-md);padding:48px 24px;text-align:center;color:var(--muted)}
.emptystate p{max-width:46ch;margin:0 auto 16px}

/* Settings */
.settings{display:grid;gap:24px;max-width:760px}
.settings section{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-md);padding:20px}
.settings h2{font-size:16px;margin:0 0 4px}
.settings .hint{color:var(--muted);margin:0 0 16px;font-size:14px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px 16px}
.field{display:flex;flex-direction:column;gap:5px}
.field label{font-size:13.5px;font-weight:500;color:var(--muted)}
.field.full{grid-column:1/-1}
.check{display:flex;align-items:center;gap:8px;font-size:14px}
.logoprev{display:flex;align-items:center;gap:14px}
.logoprev img{width:64px;height:64px;object-fit:contain;border:1px solid var(--line);border-radius:var(--r-sm);padding:4px;background:#fff}
input[type=color]{width:56px;height:38px;border:1px solid var(--line);border-radius:var(--r-sm);padding:2px;background:#fff;cursor:pointer}

/* Modal */
.overlay{position:fixed;inset:0;background:rgba(20,26,36,.45);display:none;align-items:flex-start;justify-content:center;padding:6vh 16px;z-index:50;overflow:auto}
.overlay.open{display:flex}
.modal{background:var(--surface);border-radius:var(--r-md);width:100%;max-width:640px;box-shadow:0 18px 50px rgba(15,20,30,.25)}
.modal header{padding:18px 22px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center}
.modal header h3{margin:0;font-size:18px}
.modal .body{padding:20px 22px}
.modal footer{padding:14px 22px;border-top:1px solid var(--line);display:flex;justify-content:flex-end;gap:8px}
.err{color:var(--bad);font-size:14px;margin-top:10px;min-height:1em}

/* Setup */
.setup{position:fixed;inset:0;background:var(--bg);display:none;align-items:center;justify-content:center;padding:24px;z-index:60}
.setup.open{display:flex}
.setup .card{background:var(--surface);border:1px solid var(--line);border-top:6px solid var(--brand);border-radius:var(--r-md);padding:32px;max-width:520px;width:100%}
.setup h1{margin:0 0 6px;font-size:26px}
.setup p{margin:0 0 22px;color:var(--muted)}

.toast{position:fixed;bottom:24px;inset-inline-end:24px;background:var(--ink);color:#fff;padding:10px 16px;border-radius:var(--r-sm);opacity:0;transform:translateY(8px);transition:.2s;pointer-events:none;z-index:70}
.toast.show{opacity:1;transform:none}

input[type=time],input[type=password]{border:1px solid var(--line);background:var(--surface);border-radius:var(--r-sm);padding:8px 10px;width:100%;min-height:38px}
/* Clock-in */
.clockwrap{max-width:520px;margin:0 auto}
.clockface{text-align:center;padding:12px 0 28px}
.clockface .time{font-size:clamp(56px,12vw,96px);font-weight:600;line-height:1;letter-spacing:-.03em;font-variant-numeric:tabular-nums;color:var(--brand)}
.clockface .day{color:var(--muted);margin-top:8px}
.clockcard{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-md);padding:22px;display:grid;gap:14px}
.clockcard .state{font-size:14px;color:var(--muted);min-height:1.5em}
.clockbtn{padding:16px;font-size:18px;font-weight:600;border-radius:var(--r-md);border:0;cursor:pointer;background:var(--brand);color:var(--on-brand)}
.clockbtn.out{background:var(--ink);color:#fff}
.clockbtn:disabled{opacity:.55;cursor:not-allowed}
.msg{padding:12px 14px;border-radius:var(--r-sm);font-size:14.5px;display:none}
.msg.show{display:block}
.msg.ok{background:color-mix(in srgb,var(--ok) 12%,#fff);color:var(--ok)}
.msg.bad{background:color-mix(in srgb,var(--bad) 10%,#fff);color:var(--bad)}
.msg.info{background:var(--brand-soft);color:var(--brand)}
.kioskbar{text-align:center;margin-top:28px}
body.kiosk .app{grid-template-columns:1fr}
body.kiosk .side{display:none}
body.kiosk .main{max-width:none;padding-top:8vh}
h3.sub{font-size:16px;margin:28px 0 12px}

/* Payslip */
#printArea{display:none}
.slip{max-width:720px;margin:0 auto;font-size:14px}
.slip .top{display:flex;justify-content:space-between;align-items:center;border-bottom:3px solid var(--brand);padding-bottom:14px;margin-bottom:16px}
.slip .top img{height:56px}
.slip h2{margin:0;font-size:22px}
.slip .meta{display:grid;grid-template-columns:1fr 1fr;gap:6px 24px;margin-bottom:18px}
.slip .meta span{color:var(--muted)}
.slip table td,.slip table th{padding:8px 10px;border:1px solid var(--line)}
.slip .netline{display:flex;justify-content:space-between;background:var(--brand-soft);border:1px solid var(--brand-line);padding:12px 14px;margin-top:14px;font-size:17px;font-weight:700}
.slip .sign{display:flex;justify-content:space-between;margin-top:56px;color:var(--muted)}
.slip .sign div{border-top:1px solid var(--muted);padding-top:6px;width:40%}

@media print{
  body.printing > *:not(#printArea){display:none!important}
  body.printing #printArea{display:block}
  body{background:#fff}
  @page{margin:16mm}
}
@media (max-width:1000px){
  .strip{grid-template-columns:repeat(2,1fr)}
  .strip div{border-inline-start:0;border-top:1px solid var(--line)}
  .strip div:nth-child(-n+2){border-top:0}
  .cols{grid-template-columns:1fr}
}
@media (max-width:760px){
  .app{grid-template-columns:1fr}
  .side{position:static;height:auto;padding:14px;gap:12px}
  .nav{flex-direction:row;overflow-x:auto;gap:4px}
  .nav button{white-space:nowrap}
  .side .foot{display:none}
  .main{padding:20px 16px 48px}
  .grid2{grid-template-columns:1fr}
}
@media (prefers-reduced-motion:reduce){.toast{transition:none}}
</style>
</head>
<body>

<div class="app">
  <aside class="side">
    <div class="brandmark" id="brandmark"></div>
    <nav class="nav" id="nav" aria-label="Main"></nav>
    <div class="foot" id="foot"></div>
  </aside>
  <main class="main" id="main"></main>
</div>

<div class="overlay" id="overlay" role="dialog" aria-modal="true">
  <div class="modal">
    <form id="modalForm" novalidate>
      <header><h3 id="modalTitle"></h3><button type="button" class="btn ghost" data-close aria-label="Close">✕</button></header>
      <div class="body" id="modalBody"></div>
      <footer id="modalFoot"></footer>
    </form>
  </div>
</div>

<div class="setup" id="setup">
  <form class="card" id="setupForm">
    <h1 data-t="setupTitle"></h1>
    <p data-t="setupSub"></p>
    <div class="grid2">
      <div class="field full"><label data-t="companyName"></label><input type="text" name="company" required></div>
      <div class="field"><label data-t="language"></label>
        <select name="lang"><option value="en">English</option><option value="ar">العربية</option></select></div>
      <div class="field"><label data-t="currency"></label><input type="text" name="currency" maxlength="6"></div>
      <div class="field"><label data-t="brandColor"></label><input type="color" name="color"></div>
    </div>
    <div class="err" id="setupErr"></div>
    <button class="btn primary" type="submit" style="margin-top:8px" data-t="start"></button>
  </form>
</div>

<div class="toast" id="toast" role="status"></div>
<div id="printArea"></div>

