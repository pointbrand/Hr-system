function textOn(hex){const h=hex.replace('#','');const [r,g,b]=[0,2,4].map(i=>parseInt(h.substr(i,2),16)/255).map(c=>c<=.03928?c/12.92:Math.pow((c+.055)/1.055,2.4));return (.2126*r+.7152*g+.0722*b)>.45?'#141A24':'#FFFFFF'}
function download(name,content,type){const blob=new Blob([content],{type});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;document.body.appendChild(a);a.click();setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove()},500)}

function leaveDaysIn(l,from,to){ // overlap days between leave l and [from,to]
  const s=l.from>from?l.from:from, e=l.to<to?l.to:to; return s>e?0:daysBetween(s,e);
}
function onLeave(empId,date){return S.leaves.some(l=>l.empId===empId&&l.status==='approved'&&l.from<=date&&l.to>=date)}
function annualUsed(empId,year){return S.leaves.filter(l=>l.empId===empId&&l.status==='approved'&&l.type==='annual').reduce((a,l)=>a+leaveDaysIn(l,year+'-01-01',year+'-12-31'),0)}

