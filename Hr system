  $('#sShort').onchange=e=>saveS('deductShort',e.target.checked);
  $('#sAdmin').onchange=e=>saveS('adminPin',e.target.value.trim());
  $('#sLogo').onchange=e=>{const f=e.target.files[0];if(!f)return;if(f.size>500*1024){toast(t('logoTooBig'));return}
    const r=new FileReader();r.onload=()=>{S.settings.logo=r.result;persist();render();toast(t('saved'))};r.readAsDataURL(f)};
  $('#sImport').onchange=e=>{const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{
    try{const d=JSON.parse(r.result);if(!d||!Array.isArray(d.employees)||!d.settings)throw 0;
      S=Object.assign(blank(),d,{settings:Object.assign(blank().settings,d.settings,{setupDone:true})});persist();render();toast(t('restored'))}
    catch(err){toast(t('badBackup'))}};r.readAsText(f)};
};

/* ---------- Modal ---------- */
let modalSave=null;
function openModal(title,body,onSave,saveLabel){
  $('#modalTitle').textContent=title;$('#modalBody').innerHTML=body+'<div class="err" id="mErr"></div>';
  $('#modalFoot').innerHTML=`<button type="button" class="btn" data-close>${t('cancel')}</button><button type="submit" class="btn primary">${saveLabel||t('save')}</button>`;
  modalSave=onSave;$('#overlay').classList.add('open');
  setTimeout(()=>{const f=$('#modalBody').querySelector('input,select');f&&f.focus()},30);
}
function closeModal(){$('#overlay').classList.remove('open');modalSave=null}
$('#modalForm').onsubmit=e=>{e.preventDefault();
  const form=e.target;const missing=[...form.querySelectorAll('[required]')].some(i=>!i.value.trim());
  if(missing){$('#mErr').textContent=t('required');return}
  const data=Object.fromEntries(new FormData(form));form.querySelectorAll('input[type=checkbox]').forEach(c=>data[c.name]=c.checked);
  const err=modalSave&&modalSave(data);if(err){$('#mErr').textContent=err;return}
  closeModal();persist();render();toast(t('saved'));
};
$('#overlay').addEventListener('click',e=>{if(e.target.id==='overlay'||e.target.closest('[data-close]'))closeModal()});
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&$('#overlay').classList.contains('open'))closeModal()});

/* ---------- Payslip ---------- */
function printSlip(id){
  const e=emp(id),m=ui.payMonth,c=calcPay(e,m),s=S.settings;
  const row=(k,v)=>`<tr><td>${k}</td><td style="text-align:end">${money(v)}</td></tr>`;
  $('#printArea').innerHTML=`<div class="slip" dir="${s.lang==='ar'?'rtl':'ltr'}">
    <div class="top"><div><h2>${esc(s.company)}</h2><div style="color:var(--muted)">${t('payslip')} — ${monthLabel(m)}</div></div>${s.logo?`<img src="${s.logo}" alt="">`:''}</div>
    <div class="meta"><div><span>${t('employee')}:</span> ${esc(e.name)}</div><div><span>${t('empNo')}:</span> ${esc(e.empNo||'—')}</div>
      <div><span>${t('jobTitle')}:</span> ${esc(e.jobTitle||'—')}</div><div><span>${t('department')}:</span> ${esc(dept(e.deptId)?.name||'—')}</div>
      <div><span>${t('idNo')}:</span> ${esc(e.idNo||'—')}</div><div><span>${t('period')}:</span> ${monthLabel(m)}</div></div>
    <table style="width:100%;border-collapse:collapse;margin-bottom:12px"><thead><tr><th colspan="2" style="text-align:start">${t('earnings')}</th></tr></thead><tbody>
      ${row(t('basic'),e.basic)}${num(e.housing)?row(t('housing'),e.housing):''}${num(e.transport)?row(t('transport'),e.transport):''}${num(e.other)?row(t('otherAllow'),e.other):''}${c.otPay?row(t('otPay')+` (${hrs(c.otH)} ${t('h')})`,c.otPay):''}${c.add?row(t('additions'),c.add):''}</tbody></table>
    <table style="width:100%;border-collapse:collapse"><thead><tr><th colspan="2" style="text-align:start">${t('deductions')}</th></tr></thead><tbody>
      ${c.absenceDed?row(t('absenceDed')+` (${c.absent} ${t('days')})`,c.absenceDed):''}${c.unpaidDed?row(t('unpaidDed')+` (${c.unpaidDays} ${t('days')})`,c.unpaidDed):''}${c.gosi?row(t('gosi'),c.gosi):''}${c.shortDed?row(t('shortDed')+` (${hrs(c.shortH)} ${t('h')})`,c.shortDed):''}${c.ded?row(t('deductions'),c.ded):''}
      ${!(c.absenceDed||c.unpaidDed||c.gosi||c.ded||c.shortDed)?`<tr><td colspan="2">—</td></tr>`:''}</tbody></table>
    <div class="netline"><span>${t('net')}</span><span>${money(c.net)}</span></div>
    <div class="sign"><div>${t('signature')}</div><div>${t('approverSig')}</div></div></div>`;
  document.body.classList.add('printing');window.print();setTimeout(()=>document.body.classList.remove('printing'),300);
}

/* ---------- Actions ---------- */
document.addEventListener('click',e=>{
  const nv=e.target.closest('[data-view]');if(nv){view=nv.dataset.view;render();window.scrollTo(0,0);return}
  const b=e.target.closest('[data-act]');if(!b)return;const id=b.dataset.id,a=b.dataset.act;
  if(a==='addEmp'||a==='editEmp'){const ex=a==='editEmp'?emp(id):null;
    openModal(t(ex?'editEmployee':'addEmployee'),empForm(ex||{}),d=>{
      const rec={...d,basic:num(d.basic),housing:num(d.housing),transport:num(d.transport),other:num(d.other),annualDays:num(d.annualDays),dailyHours:num(d.dailyHours)};
      if(ex)Object.assign(ex,rec);else S.employees.push({id:uid(),...rec});});}
  if(a==='delEmp'&&confirm(t('confirmDelete'))){S.employees=S.employees.filter(x=>x.id!==id);S.leaves=S.leaves.filter(l=>l.empId!==id);
    S.departments.forEach(d=>{if(d.managerId===id)d.managerId=''});persist();render();}
  if(a==='addDept'||a==='editDept'){const ex=a==='editDept'?dept(id):null;
    openModal(t(ex?'editDept':'addDept'),`<div class="grid2"><div class="field full"><label>${t('deptName')} *</label><input type="text" name="name" required value="${esc(ex?.name||'')}"></div>
      <div class="field full"><label>${t('manager')}</label><select name="managerId"><option value="">${t('none')}</option>${activeEmps().map(x=>`<option value="${x.id}" ${ex?.managerId===x.id?'selected':''}>${esc(x.name)}</option>`).join('')}</select></div></div>`,
      d=>{if(ex)Object.assign(ex,d);else S.departments.push({id:uid(),...d});});}
  if(a==='delDept'){if(S.employees.some(x=>x.deptId===id)){toast(t('deptInUse'));return}
    if(confirm(t('confirmDelete'))){S.departments=S.departments.filter(x=>x.id!==id);persist();render();}}
  if(a==='att'){const rec=S.attendance[ui.attDate]=S.attendance[ui.attDate]||{};rec[id]=rec[id]===b.dataset.s?undefined:b.dataset.s;
    if(!rec[id])delete rec[id];persist();R.attendance();}
  if(a==='allPresent'){const rec=S.attendance[ui.attDate]=S.attendance[ui.attDate]||{};
    activeEmps().forEach(x=>{if(!onLeave(x.id,ui.attDate)&&!rec[x.id])rec[x.id]='present'});persist();R.attendance();}
  if(a==='lf'){ui.leaveFilter=b.dataset.s;R.leaves();}
  if(a==='addLeave'){const td=todayStr();
    openModal(t('newRequest'),`<div class="grid2">
      <div class="field full"><label>${t('employee')} *</label><select name="empId" required><option value="">${t('selectEmp')}</option>${activeEmps().map(x=>`<option value="${x.id}">${esc(x.name)} — ${t('leaveBalance')}: ${num(x.annualDays)-annualUsed(x.id,new Date().getFullYear())}</option>`).join('')}</select></div>
      <div class="field"><label>${t('type')}</label><select name="type">${leaveTypes.map(ty=>`<option value="${ty}">${leaveLabel(ty)}</option>`).join('')}</select></div>
      <div class="field"><label>${t('status')}</label><select name="status"><option value="pending">${t('pendingS')}</option><option value="approved">${t('approved')}</option></select></div>
      <div class="field"><label>${t('from')} *</label><input type="date" name="from" required value="${td}"></div>
      <div class="field"><label>${t('to')} *</label><input type="date" name="to" required value="${td}"></div>
      <div class="field full"><label>${t('note')}</label><textarea name="note"></textarea></div></div>`,
      d=>{if(d.to<d.from)return t('dateOrder');S.leaves.push({id:uid(),created:Date.now(),...d});});}
  if(a==='lApprove'||a==='lReject'){const l=S.leaves.find(x=>x.id===id);l.status=a==='lApprove'?'approved':'rejected';persist();R.leaves();toast(t(l.status));}
  if(a==='delLeave'&&confirm(t('confirmDelete'))){S.leaves=S.leaves.filter(x=>x.id!==id);persist();R.leaves();}
  if(a==='punch')doPunch();
  if(a==='kiosk')location.hash='kiosk';
  if(a==='exitKiosk'){const p=S.settings.adminPin;if(p&&prompt(t('enterAdminPin'))!==p){toast(t('wrongPin'));return}
    history.replaceState(null,'',location.pathname+location.search);view='dashboard';render();}
  if(a==='addLoc'||a==='editLoc'){const ex=a==='editLoc'?locById(id):null;
    openModal(ex?ex.name:t('addLoc'),`<div class="grid2">
      <div class="field full"><label>${t('locName')} *</label><input type="text" name="name" required value="${esc(ex?.name||'')}"></div>
      <div class="field"><label>${t('lat')} *</label><input type="text" name="lat" inputmode="decimal" required value="${esc(ex?.lat??'')}"></div>
      <div class="field"><label>${t('lng')} *</label><input type="text" name="lng" inputmode="decimal" required value="${esc(ex?.lng??'')}"></div>
      <div class="field"><label>${t('radius')} *</label><input type="number" name="radius" min="10" required value="${esc(ex?.radius??100)}"></div>
      <div class="field" style="justify-content:flex-end"><button type="button" class="btn" data-act="hereLoc">${t('useHere')}</button></div>
      <div class="field full" id="hereMsg" style="color:var(--muted);font-size:13.5px"></div></div>`,
      d=>{const lat=parseFloat(d.lat),lng=parseFloat(d.lng);if(!(lat>=-90&&lat<=90&&lng>=-180&&lng<=180))return t('invalidCoords');
        const rec={name:d.name.trim(),lat:+lat.toFixed(6),lng:+lng.toFixed(6),radius:Math.max(10,num(d.radius))};
        S.settings.locations=S.settings.locations||[];if(ex)Object.assign(ex,rec);else S.settings.locations.push({id:uid(),...rec});});}
  if(a==='hereLoc'){const msg=$('#hereMsg');msg.textContent=t('locating');b.disabled=true;
    getBestPos(15,20000).then(p=>{const f=$('#modalForm');f.elements.lat.value=p.latitude.toFixed(6);f.elements.lng.value=p.longitude.toFixed(6);msg.textContent=tf('gotHere',{a:Math.round(p.accuracy)})})
    .catch(err=>{msg.textContent=t(err&&err.code===1?'geoDenied':'geoFail')}).finally(()=>{b.disabled=false});}
  if(a==='delLoc'&&confirm(t('confirmDelete'))){S.settings.locations=S.settings.locations.filter(l=>l.id!==id);S.employees.forEach(x=>{if(x.locId===id)x.locId=''});persist();render();}
  if(a==='addPunch'){
    openModal(t('addPunch'),`<div class="grid2">
      <div class="field full"><label>${t('employee')} *</label><select name="empId" required><option value="">${t('selectEmp')}</option>${S.employees.map(x=>`<option value="${x.id}" ${ui.tlEmp===x.id?'selected':''}>${esc(x.name)}</option>`).join('')}</select></div>
      <div class="field"><label>${t('punchType')}</label><select name="type"><option value="in">${t('clockIn')}</option><option value="out">${t('clockOut')}</option></select></div>
      <div class="field"><label>${t('date')} *</label><input type="date" name="date" required value="${todayStr()}"></div>
      <div class="field"><label>${t('time')} *</label><input type="time" name="time" required></div>
      <div class="field"><label>${t('note')}</label><input type="text" name="note"></div></div>`,
      d=>{S.punches.push({id:uid(),empId:d.empId,type:d.type,ts:new Date(d.date+'T'+d.time).getTime(),manual:true,note:d.note,locId:emp(d.empId)?.locId||''});});}
  if(a==='delSession'&&confirm(t('confirmDelete'))){const ids=b.dataset.ids.split(',');S.punches=S.punches.filter(p=>!ids.includes(p.id));persist();R.timelog();}
  if(a==='slip')printSlip(id);
  if(a==='csv'){const m=ui.payMonth;const head=[t('empNo'),t('employee'),t('idNo'),t('gross'),t('absenceDed'),t('unpaidDed'),t('gosi'),t('otPay'),t('shortDed'),t('additions'),t('deductions'),t('net')];
    const q=v=>'"'+String(v).replace(/"/g,'""')+'"';const f=n=>num(n).toFixed(2);
    const allS=buildSessions();const lines=[head.map(q).join(',')].concat(activeEmps().map(x=>{const c=calcPay(x,m,allS);return [x.empNo||'',x.name,x.idNo||'',f(c.gross),f(c.absenceDed),f(c.unpaidDed),f(c.gosi),f(c.otPay),f(c.shortDed),f(c.add),f(c.ded),f(c.net)].map(q).join(',')}));
    download(`payroll-${m}.csv`,'\uFEFF'+lines.join('\r\n'),'text/csv;charset=utf-8');}
  if(a==='rmLogo'){S.settings.logo='';persist();render();}
  if(a==='exportJson')download(`hr-backup-${todayStr()}.json`,JSON.stringify(S,null,2),'application/json');
  if(a==='reset'&&confirm(t('resetConfirm'))){const keep=S.settings;S=blank();S.settings=keep;persist();render();toast(t('erased'));}
});

/* ---------- First-run setup ---------- */
function showSetup(){
  const f=$('#setupForm');f.company.value=S.settings.company;f.lang.value=S.settings.lang;f.currency.value=S.settings.currency;f.color.value=S.settings.color;
  $('#setup').classList.add('open');applyTheme();
  f.lang.onchange=()=>{S.settings.lang=f.lang.value;applyTheme()};
  f.color.oninput=()=>{S.settings.color=f.color.value;applyTheme()};
  f.onsubmit=e=>{e.preventDefault();if(!f.company.value.trim()){$('#setupErr').textContent=t('required');return}
    Object.assign(S.settings,{company:f.company.value.trim(),lang:f.lang.value,currency:f.currency.value.trim()||'SAR',color:f.color.value,setupDone:true});
    persist();$('#setup').classList.remove('open');render();};
}

window.addEventListener('hashchange',render);
render();
if(!S.settings.setupDone)showSetup();
</script>
</body>
