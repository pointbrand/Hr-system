function updateClockState(){
  const id=$('#cEmp').value,btn=$('#cBtn'),st=$('#cState');
  if(!id){btn.disabled=true;st.textContent='';btn.textContent=t('clockIn');btn.classList.remove('out');return}
  const lp=lastPunch(id),isIn=lp&&lp.type==='in',l=locById(emp(id).locId);
  st.textContent=(isIn?tf('since',{t:fmtTime(lp.ts)}):t('notIn'))+(l?' — '+l.name:'');
  btn.disabled=false;btn.textContent=t(isIn?'clockOut':'clockIn');btn.classList.toggle('out',!!isIn);
}
function showMsg(kind,text){const m=$('#cMsg');m.className='msg show '+kind;m.textContent=text}
async function doPunch(){
  const id=$('#cEmp').value,e=emp(id);if(!e)return;
  if(e.pin&&$('#cPin').value!==String(e.pin)){showMsg('bad',t('wrongPin'));return}
  const locs=e.locId&&locById(e.locId)?[locById(e.locId)]:(S.settings.locations||[]);
  if(!locs.length){showMsg('bad',t('noLocs'));return}
  const btn=$('#cBtn');btn.disabled=true;showMsg('info',t('locating'));
  const maxAcc=num(S.settings.maxAcc)||50;
  let pos;try{pos=await getBestPos(maxAcc)}catch(err){showMsg('bad',t(err&&err.code===1?'geoDenied':'geoFail'));updateClockState();return}
  if(pos.accuracy>maxAcc){showMsg('bad',tf('lowAcc',{a:Math.round(pos.accuracy),m:maxAcc}));updateClockState();return}
  const near=locs.map(l=>({l,d:distM(pos.latitude,pos.longitude,num(l.lat),num(l.lng))})).sort((a,b)=>a.d-b.d)[0];
  if(near.d>num(near.l.radius)){showMsg('bad',tf('tooFar',{d:Math.round(near.d),l:near.l.name,r:near.l.radius}));updateClockState();return}
  const lp=lastPunch(id),type=lp&&lp.type==='in'?'out':'in',now=Date.now();
  S.punches.push({id:uid(),empId:id,type,ts:now,lat:+pos.latitude.toFixed(6),lng:+pos.longitude.toFixed(6),acc:Math.round(pos.accuracy),dist:Math.round(near.d),locId:near.l.id});
  if(type==='in'){const d=todayStr(),rec=S.attendance[d]=S.attendance[d]||{};
    if(!rec[id]){const [hh,mm]=(e.shiftStart||S.settings.shiftStart||'09:00').split(':').map(Number);const lim=new Date();lim.setHours(hh,mm+num(S.settings.grace),0,0);rec[id]=now>lim.getTime()?'late':'present'}}
  persist();
  showMsg('ok',type==='in'?tf('clockedIn',{n:e.name,t:fmtTime(now)}):tf('clockedOut',{n:e.name,t:fmtTime(now),h:hrs((now-lp.ts)/36e5)}));
  $('#cPin').value='';updateClockState();
  if(isKiosk())setTimeout(()=>{if($('#cEmp')){$('#cEmp').value='';updateClockState()}},6000);
}

